/*C3*/SET SCHEMA PUBLIC
DROP TABLE IF EXISTS racebikesdb
CREATE TABLE racebikesdb (id INTEGER IDENTITY PRIMARY KEY,brand VARCHAR(20) NOT NULL, model VARCHAR(50) NOT NULL,color VARCHAR(15),weight DOUBLE,frameSize INTEGER,releaseDate DATE,price DECIMAL(10,2),currency VARCHAR(5),groupset VARCHAR(50),frameMaterial VARCHAR(20),forkMaterial VARCHAR(20),brakeType VARCHAR(30),wheelSize VARCHAR(30),UNIQUE(brand, model))
